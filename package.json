{
  "name": "relay-bridge",
  "version": "0.2.1",
  "description": "A local MCP server that lets Claude Code delegate real repository work to other AI coding agents, starting with Gemini through the Google Antigravity CLI.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "relay-bridge": "dist/index.js",
    "relay-stats": "dist/cli/stats.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RELAY_BRIDGE_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "doctor": "node dist/cli/doctor.js",
    "stats": "node dist/cli/stats.js",
    "skill:install": "node scripts/skill.mjs install",
    "skill:uninstall": "node scripts/skill.mjs uninstall",
    "labels": "node scripts/labels.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
